{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Canvas Mono",
  "author": "Moussa Toure",
  "themes": [
    {
      "name": "Canvas Mono",
      "appearance": "light",
      "style": {
        "border": "#D6D6D6",
        "border.variant": "#E0E0E0",
        "border.focused": "#2F6BE0",
        "border.selected": "#2F6BE0",
        "elevated_surface.background": "#F3F3F3",
        "surface.background": "#EDEDED",
        "background": "#E4E4E4",
        "element.background": "#F3F3F3",
        "element.hover": "#E4E4E4",
        "element.active": "#DCDCDC",
        "element.selected": "#DCDCDC",
        "ghost_element.hover": "#E4E4E4",
        "ghost_element.selected": "#DCDCDC",
        "text": "#2B2B2B",
        "text.muted": "#8A8A8A",
        "text.placeholder": "#A8A8A8",
        "text.disabled": "#B4B4B4",
        "text.accent": "#2F6BE0",
        "icon": "#5C5C5C",
        "icon.muted": "#9A9A9A",
        "icon.accent": "#2F6BE0",
        "status_bar.background": "#E4E4E4",
        "title_bar.background": "#E4E4E4",
        "title_bar.inactive_background": "#E4E4E4",
        "toolbar.background": "#F3F3F3",
        "tab_bar.background": "#E4E4E4",
        "tab.inactive_background": "#E4E4E4",
        "tab.active_background": "#F3F3F3",
        "panel.background": "#EDEDED",
        "panel.focused_border": "#2F6BE0",
        "scrollbar.thumb.background": "#0000001A",
        "scrollbar.thumb.hover_background": "#0000002A",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",
        "editor.background": "#F3F3F3",
        "editor.foreground": "#2B2B2B",
        "editor.gutter.background": "#F3F3F3",
        "editor.active_line.background": "#EBEBEB",
        "editor.line_number": "#B4B4B4",
        "editor.active_line_number": "#2B2B2B",
        "editor.indent_guide": "#E2E2E2",
        "editor.indent_guide_active": "#C8C8C8",
        "editor.wrap_guide": "#DADADA",
        "editor.document_highlight.read_background": "#2F6BE01A",
        "editor.document_highlight.write_background": "#2F6BE02A",
        "search.match_background": "#F0613F33",
        "terminal.background": "#F3F3F3",
        "terminal.foreground": "#2B2B2B",
        "terminal.ansi.black": "#2B2B2B",
        "terminal.ansi.red": "#D9482B",
        "terminal.ansi.green": "#4C9A6A",
        "terminal.ansi.yellow": "#C98A1A",
        "terminal.ansi.blue": "#2F6BE0",
        "terminal.ansi.magenta": "#8E5CC4",
        "terminal.ansi.cyan": "#2E8C9A",
        "terminal.ansi.white": "#8A8A8A",
        "terminal.ansi.bright_black": "#5C5C5C",
        "terminal.ansi.bright_red": "#F0613F",
        "terminal.ansi.bright_green": "#5DB07E",
        "terminal.ansi.bright_yellow": "#DDA13A",
        "terminal.ansi.bright_blue": "#4F86EE",
        "terminal.ansi.bright_magenta": "#A57AD6",
        "terminal.ansi.bright_cyan": "#45A7B5",
        "terminal.ansi.bright_white": "#B4B4B4",
        "link_text.hover": "#2F6BE0",
        "created": "#4C9A6A",
        "modified": "#2F6BE0",
        "deleted": "#F0613F",
        "conflict": "#C98A1A",
        "error": "#D9482B",
        "warning": "#C98A1A",
        "info": "#2F6BE0",
        "hint": "#8A8A8A",
        "success": "#4C9A6A",
        "ignored": "#B4B4B4",
        "hidden": "#B4B4B4",
        "players": [
          { "cursor": "#2F6BE0", "selection": "#2F6BE02E", "background": "#2F6BE0" },
          { "cursor": "#F0613F", "selection": "#F0613F2E", "background": "#F0613F" }
        ],
        "syntax": {
          "comment": { "color": "#9A9A9A", "font_style": "italic" },
          "comment.doc": { "color": "#9A9A9A", "font_style": "italic" },
          "keyword": { "color": "#2F6BE0" },
          "operator": { "color": "#6E6E6E" },
          "punctuation": { "color": "#6E6E6E" },
          "punctuation.bracket": { "color": "#6E6E6E" },
          "punctuation.delimiter": { "color": "#6E6E6E" },
          "string": { "color": "#B8502F" },
          "string.escape": { "color": "#D9482B" },
          "string.special": { "color": "#D9482B" },
          "number": { "color": "#D9482B" },
          "boolean": { "color": "#D9482B" },
          "constant": { "color": "#D9482B" },
          "function": { "color": "#1F1F1F", "font_weight": 700 },
          "function.method": { "color": "#1F1F1F", "font_weight": 700 },
          "type": { "color": "#2459C2" },
          "constructor": { "color": "#2459C2" },
          "variable": { "color": "#2B2B2B" },
          "variable.special": { "color": "#F0613F" },
          "property": { "color": "#5C5C5C" },
          "attribute": { "color": "#5C5C5C" },
          "tag": { "color": "#2F6BE0" },
          "title": { "color": "#2B2B2B", "font_weight": 700 },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "link_uri": { "color": "#2F6BE0" },
          "link_text": { "color": "#2B2B2B" },
          "text.literal": { "color": "#B8502F" }
        }
      }
    }
  ]
}
