{
  "$schema": "vscode://schemas/color-theme",
  "name": "Canvas Mono",
  "type": "light",
  "colors": {
    "focusBorder": "#2F6BE0",
    "foreground": "#2B2B2B",
    "descriptionForeground": "#8A8A8A",
    "disabledForeground": "#B4B4B4",
    "errorForeground": "#D9482B",
    "icon.foreground": "#5C5C5C",
    "widget.shadow": "#00000000",
    "selection.background": "#2F6BE033",
    "sash.hoverBorder": "#2F6BE0",

    "editor.background": "#F3F3F3",
    "editor.foreground": "#2B2B2B",
    "editorLineNumber.foreground": "#B4B4B4",
    "editorLineNumber.activeForeground": "#2B2B2B",
    "editorCursor.foreground": "#2F6BE0",
    "editor.selectionBackground": "#2F6BE02E",
    "editor.inactiveSelectionBackground": "#2F6BE01A",
    "editor.selectionHighlightBackground": "#2F6BE01A",
    "editor.wordHighlightBackground": "#00000010",
    "editor.wordHighlightStrongBackground": "#00000018",
    "editor.findMatchBackground": "#F0613F40",
    "editor.findMatchHighlightBackground": "#F0613F22",
    "editor.lineHighlightBackground": "#EBEBEB",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background1": "#E2E2E2",
    "editorIndentGuide.activeBackground1": "#C8C8C8",
    "editorWhitespace.foreground": "#D6D6D6",
    "editorRuler.foreground": "#DADADA",
    "editorBracketMatch.background": "#2F6BE01A",
    "editorBracketMatch.border": "#2F6BE066",
    "editorGutter.background": "#F3F3F3",
    "editorGutter.addedBackground": "#4C9A6A",
    "editorGutter.modifiedBackground": "#2F6BE0",
    "editorGutter.deletedBackground": "#F0613F",
    "editorError.foreground": "#D9482B",
    "editorWarning.foreground": "#C98A1A",
    "editorInfo.foreground": "#2F6BE0",
    "editorWidget.background": "#F3F3F3",
    "editorWidget.border": "#D6D6D6",
    "editorSuggestWidget.background": "#F3F3F3",
    "editorSuggestWidget.border": "#D6D6D6",
    "editorSuggestWidget.selectedBackground": "#E4E4E4",
    "editorSuggestWidget.highlightForeground": "#2F6BE0",
    "editorHoverWidget.background": "#F3F3F3",
    "editorHoverWidget.border": "#D6D6D6",
    "editorOverviewRuler.border": "#00000000",
    "editorBracketHighlight.foreground1": "#5C5C5C",
    "editorBracketHighlight.foreground2": "#2F6BE0",
    "editorBracketHighlight.foreground3": "#F0613F",

    "editorGroupHeader.tabsBackground": "#E4E4E4",
    "editorGroupHeader.tabsBorder": "#D6D6D6",
    "editorGroup.border": "#D6D6D6",
    "tab.activeBackground": "#F3F3F3",
    "tab.activeForeground": "#2B2B2B",
    "tab.activeBorderTop": "#2F6BE0",
    "tab.inactiveBackground": "#E4E4E4",
    "tab.inactiveForeground": "#8A8A8A",
    "tab.border": "#D6D6D6",
    "tab.hoverBackground": "#ECECEC",
    "breadcrumb.foreground": "#8A8A8A",
    "breadcrumb.focusForeground": "#2B2B2B",
    "breadcrumb.background": "#F3F3F3",

    "titleBar.activeBackground": "#E4E4E4",
    "titleBar.activeForeground": "#5C5C5C",
    "titleBar.inactiveBackground": "#E4E4E4",
    "titleBar.inactiveForeground": "#8A8A8A",
    "titleBar.border": "#D6D6D6",
    "activityBar.background": "#E4E4E4",
    "activityBar.foreground": "#2B2B2B",
    "activityBar.inactiveForeground": "#9A9A9A",
    "activityBar.border": "#D6D6D6",
    "activityBar.activeBorder": "#2F6BE0",
    "activityBarBadge.background": "#2F6BE0",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#EDEDED",
    "sideBar.foreground": "#2B2B2B",
    "sideBar.border": "#D6D6D6",
    "sideBarTitle.foreground": "#5C5C5C",
    "sideBarSectionHeader.background": "#E4E4E4",
    "sideBarSectionHeader.foreground": "#5C5C5C",
    "sideBarSectionHeader.border": "#D6D6D6",
    "list.activeSelectionBackground": "#2F6BE0",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.activeSelectionIconForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#DCDCDC",
    "list.hoverBackground": "#E4E4E4",
    "list.focusOutline": "#2F6BE0",
    "list.highlightForeground": "#2F6BE0",
    "tree.indentGuidesStroke": "#D6D6D6",

    "panel.background": "#F3F3F3",
    "panel.border": "#D6D6D6",
    "panelTitle.activeForeground": "#2B2B2B",
    "panelTitle.inactiveForeground": "#8A8A8A",
    "panelTitle.activeBorder": "#2F6BE0",
    "terminal.background": "#F3F3F3",
    "terminal.foreground": "#2B2B2B",
    "terminalCursor.foreground": "#2F6BE0",
    "terminal.ansiBlack": "#2B2B2B",
    "terminal.ansiRed": "#D9482B",
    "terminal.ansiGreen": "#4C9A6A",
    "terminal.ansiYellow": "#C98A1A",
    "terminal.ansiBlue": "#2F6BE0",
    "terminal.ansiMagenta": "#8E5CC4",
    "terminal.ansiCyan": "#2E8C9A",
    "terminal.ansiWhite": "#8A8A8A",
    "terminal.ansiBrightBlack": "#5C5C5C",
    "terminal.ansiBrightRed": "#F0613F",
    "terminal.ansiBrightGreen": "#5DB07E",
    "terminal.ansiBrightYellow": "#DDA13A",
    "terminal.ansiBrightBlue": "#4F86EE",
    "terminal.ansiBrightMagenta": "#A57AD6",
    "terminal.ansiBrightCyan": "#45A7B5",
    "terminal.ansiBrightWhite": "#B4B4B4",

    "statusBar.background": "#E4E4E4",
    "statusBar.foreground": "#5C5C5C",
    "statusBar.border": "#D6D6D6",
    "statusBar.debuggingBackground": "#F0613F",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#E4E4E4",
    "statusBarItem.remoteBackground": "#2F6BE0",
    "statusBarItem.remoteForeground": "#FFFFFF",
    "statusBarItem.hoverBackground": "#D6D6D6",

    "badge.background": "#8E8E8E",
    "badge.foreground": "#FFFFFF",
    "button.background": "#2F6BE0",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#2459C2",
    "button.secondaryBackground": "#8E8E8E",
    "button.secondaryForeground": "#FFFFFF",
    "input.background": "#F3F3F3",
    "input.border": "#D6D6D6",
    "input.foreground": "#2B2B2B",
    "input.placeholderForeground": "#A8A8A8",
    "inputOption.activeBorder": "#2F6BE0",
    "dropdown.background": "#F3F3F3",
    "dropdown.border": "#D6D6D6",
    "checkbox.background": "#F3F3F3",
    "checkbox.border": "#B4B4B4",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#0000001A",
    "scrollbarSlider.hoverBackground": "#0000002A",
    "scrollbarSlider.activeBackground": "#0000003A",
    "progressBar.background": "#2F6BE0",
    "menu.background": "#F3F3F3",
    "menu.border": "#D6D6D6",
    "menu.selectionBackground": "#2F6BE0",
    "menu.selectionForeground": "#FFFFFF",
    "quickInput.background": "#F3F3F3",
    "quickInputList.focusBackground": "#2F6BE0",
    "quickInputList.focusForeground": "#FFFFFF",
    "notifications.background": "#F3F3F3",
    "notifications.border": "#D6D6D6",
    "textLink.foreground": "#2F6BE0",
    "textLink.activeForeground": "#2459C2",
    "gitDecoration.modifiedResourceForeground": "#2F6BE0",
    "gitDecoration.untrackedResourceForeground": "#4C9A6A",
    "gitDecoration.deletedResourceForeground": "#F0613F",
    "gitDecoration.ignoredResourceForeground": "#B4B4B4"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#9A9A9A", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#2F6BE0" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#6E6E6E" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#B8502F" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#D9482B" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#1F1F1F", "fontStyle": "bold" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#2459C2" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#2B2B2B" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#5C5C5C" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#F0613F" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#2F6BE0" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#5C5C5C" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#2B2B2B", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#B8502F" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#2F6BE0" } },
    { "scope": ["invalid"], "settings": { "foreground": "#D9482B" } }
  ],
  "semanticHighlighting": true
}
